//DB Connection
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
//Model For The Schema
model User{
  id String @id @default(uuid()) //Randomly generate userId as string
  email String @unique
  phoneNumber String? @unique //Optional but if provided must be unique
  name String 
  password String //Hashed Password
  imageUrl String?
  transactions Transaction[]
  accounts Account[]
  familyMembers FamilyMember[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  //Index
  @@index([id])
  //Mapping The User
  @@map("users")
}
model Account{
  id String @id @default(uuid()) @unique //Randomly generate accountId as string
  name String
  type AccountType
  balance Decimal @default(0) @db.Decimal
  isDefault Boolean @default(false)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  familyMembers FamilyMember[] // Only populated if type == FAMILY
  budget Budget?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
  @@index([id])
  @@unique([userId, name])   // unique per user
  @@map("accounts")
}
model FamilyMember{
  id String @id @default(uuid()) @unique
  name String
  email String? @unique
  password String?
  phoneNumber String? @unique
  invitationToken String? @unique
  invitationExpiry DateTime?
  accountId String
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  transactions Transaction[]
  familyBudget FamilyBudget?
  //Mapping
  @@unique([accountId, name])
  @@index([accountId])
  @@index([id])
  @@index([userId])
  @@map("family_members")
}
model Budget{
    id String @id @default(uuid()) @unique
    amount Decimal @default(0) @db.Decimal(10, 2)
    lastAlertSent DateTime?
    accountId String @unique
    account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt    
    @@index([accountId])
    @@index([id])
    @@map("budgets")
}
model FamilyBudget{
  id String @id @default(uuid())
  familyMemberId String @unique
  familyMember FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  lastAlertSent DateTime?
  amount Decimal @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([familyMemberId])
  @@index([id])
  @@map("family_budgets")
}
model Transaction{
    id String @id @default(uuid()) @unique
    type TransactionType
    userId String //Get the transaction for the user
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    amount Decimal @default(0) @db.Decimal
    accountId String //Get the transaction for the specific account
    account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
    //Linking the family members for transactions
    familyMemberId String?
    familyMember FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
    description String? //Optional Field
    date DateTime
    category TransactionCategory
    receiptUrl String?
    isRecurring Boolean @default(false)
    recurringInterval RecurringInterval? //Only used if isRecurring == True
    nextRecurringDate DateTime? //Next Date for the recurring transaction
    lastProcessed DateTime? //Last Time when this recurring transaction was processed
    status TransactionStatus @default(COMPLETED)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
    @@index([accountId])
    @@index([familyMemberId])
    @@index([id])
    @@map("transactions")
}
//Enum For The Schema
enum AccountType{
  CURRENT
  SAVINGS
  FAMILY
}
enum TransactionType{
  INCOME
  EXPENSE
}
enum RecurringInterval{
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}
enum TransactionStatus{
  PENDING
  COMPLETED
  FAILED
}
enum TransactionCategory{
  FOOD
  TRANSPORT
  HOUSING
  UTILITIES
  ENTERTAINMENT
  HEALTHCARE
  EDUCATION
  SHOPPING
  INVESTMENT
  SALARY
  BUSINESS
  OTHER
}