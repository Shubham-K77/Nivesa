# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=nivesa
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PASSWORD=your-redis-password
REDIS_PORT=6379

# Application Ports
BACKEND_PORT=3001
FRONTEND_PORT=3000

# Database URLs (for backend)
DATABASE_URL=postgresql://postgres:your-secure-password@postgres:5432/nivesa?schema=public
DIRECT_URL=postgresql://postgres:your-secure-password@postgres:5432/nivesa?schema=public

# Redis URL (for backend)
REDIS_URL=redis://:your-redis-password@redis:6379

# JWT Configuration
JWT_SECRET=your-jwt-secret-change-in-production

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloudinary-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Inngest Configuration
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Next.js API URL
NEXT_PUBLIC_API_URL=http://localhost:3001
